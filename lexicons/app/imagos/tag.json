{
  "lexicon": 1,
  "id": "app.imagos.tag",
  "defs": {
    "main": {
      "type": "record",
      "description": "A tag definition in the Imagos photography network.",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "description": "Display name of the tag."
          },
          "slug": {
            "type": "string",
            "maxLength": 64,
            "description": "Normalized lowercase slug for the tag."
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "description": "Optional description of the tag."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
